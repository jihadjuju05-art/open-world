{
  "name": "open-world",
  "productName": "Open World",
  "version": "0.7.0",
  "description": "Juego de mundo abierto estilo western",
  "main": "electron/main.js",
  "author": "jihadjuju05-art",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": { "electron-updater": "^6.3.9" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.jihad.openworld",
    "productName": "Open World",
    "directories": { "output": "dist" },
    "files": ["electron/**", "index.html", "src/**", "lib/**", "assets/**", "anims/**", "config/**", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false },
    "publish": [{ "provider": "github", "owner": "jihadjuju05-art", "repo": "open-world" }]
  }
}
